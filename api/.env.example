# Servidor
PORT=5000
NODE_ENV=development

# MongoDB Atlas (reemplaza usuario, contraseña y cluster)
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/elev8

# JWT (genera uno largo y aleatorio, ver README)
JWT_SECRET=cambia_este_valor_por_uno_aleatorio
JWT_EXPIRES_IN=7d

# CORS y URLs
CORS_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
